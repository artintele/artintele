# Copy to .env on the server and fill in. NEVER commit the real .env.
# ---------- required ----------
SITE_DOMAIN=artintele.ai
PUBLIC_BASE_URL=https://artintele.ai
ALLOWED_EMAIL_DOMAIN=prachalas.com
SESSION_HTTPS_ONLY=true
# generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# ---------- Google OAuth (dashboard login) ----------
# Redirect URI to register in Google Cloud: https://artintele.ai/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- email notifications (fill in to actually deliver mail) ----------
# Every new lead is emailed here as a formatted table (and always saved to CRM).
MARKETING_EMAIL=hello@artintele.ai
# Optional — leave blank until the company/sales inbox exists.
SALES_EMAIL=
#
# SMTP delivery for hello@artintele.ai (Google Workspace):
#   1. Enable 2-Step Verification on the hello@artintele.ai account.
#   2. Create an App Password (Google Account → Security → App passwords).
#   3. Put the 16-char app password (no spaces) in SMTP_PASS below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@artintele.ai
SMTP_PASS=
SMTP_FROM=hello@artintele.ai
SMTP_USE_TLS=true
