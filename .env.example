# Copy to .env and fill in. The public site + lead capture run without any of
# these. Email needs SMTP_*; the dashboard needs Google OAuth (GOOGLE_*).

# --- Where demo bookings / leads are emailed ---
SALES_EMAIL=sales@prachalas.com

# --- SMTP (sending FROM the artintele.ai dev mailbox, Google Workspace) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=devteam@artintele.ai
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=devteam@artintele.ai
# SMTP_USE_TLS=true

# --- Dashboard login: Google Workspace SSO ---
# Only Google accounts on this domain may sign in (enforced server-side).
ALLOWED_EMAIL_DOMAIN=prachalas.com
# Create an OAuth 2.0 Client (Web) in Google Cloud Console:
#   Authorized redirect URI = {PUBLIC_BASE_URL}/auth/callback
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxx
# Public origin of the deployment (used to build the OAuth redirect URI):
# PUBLIC_BASE_URL=https://your-app.up.railway.app

# --- Session cookies ---
# Strong random secret (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`).
# SESSION_SECRET=change-me-to-a-long-random-string
# Set true in production (HTTPS) so the cookie is only sent over TLS:
SESSION_HTTPS_ONLY=false
# SESSION_MAX_AGE=28800   # seconds (default 8h)

# --- Dev only ---
# When true, /auth/dev-login grants a session WITHOUT Google. Keep FALSE in prod.
DASHBOARD_DEV_BYPASS=false

# --- Optional: override the database (defaults to local SQLite) ---
# DATABASE_URL=sqlite:///./data/artintele.db
