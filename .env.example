# Copy to .env and fill in. The app runs without any of these — but email
# delivery only works once SMTP_* are set. Until then, notifications are
# logged to the console and leads are still stored.

# --- Where demo bookings / leads are emailed ---
SALES_EMAIL=sales@prachalas.com

# --- SMTP (example: Gmail with an App Password) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=your-account@gmail.com
# SMTP_USE_TLS=true

# --- Telecaller dashboard login (HTTP Basic, /dashboard) ---
ADMIN_USER=admin
ADMIN_PASS=artintele

# --- Optional: override the database (defaults to local SQLite) ---
# DATABASE_URL=sqlite:///./data/artintele.db
