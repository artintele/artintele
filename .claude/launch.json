{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "artintele",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd /Users/chiranthp/Documents/Artintele && PYTHONPATH=/Users/chiranthp/Documents/Artintele:/Users/chiranthp/Documents/Artintele/.venv/lib/python3.11/site-packages exec python3 -m uvicorn backend.main:app --host 127.0.0.1 --port ${PORT:-8000}"
      ],
      "port": 8000
    },
    {
      "comment": "Portable frontend dev server. Serves the clean URLs (/services, /blog/<slug>) via the vite.config.js middleware, so it works on any machine without the backend.",
      "name": "artintele-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5173
    },
    {
      "name": "artintele-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-c",
        "import os,http.server,functools; http.server.test(HandlerClass=functools.partial(http.server.SimpleHTTPRequestHandler, directory='frontend'), port=int(os.environ.get('PORT','8042')), bind='127.0.0.1')"
      ],
      "port": 8042,
      "autoPort": true
    }
  ]
}